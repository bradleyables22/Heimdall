<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageId>HeimdallFramework.Rendering</PackageId>
		<Version>5.1.0</Version>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<Authors>Bradley Ables</Authors>
		<Description>Server-side HTML and FluentHtml builders, shared Heimdall fluent attributes for Blazor and Razor, Tag Helpers, and typed response directives.</Description>
		<PackageTags>heimdall framework;html;fluent;SSR;aspnetcore;rendering;attributes;directives;Blazor;Razor;TagHelpers</PackageTags>
		<PackageProjectUrl>https://heimdall-framework.org</PackageProjectUrl>
		<PackageReleaseNotes>Adds the complete Heimdall fluent API for Blazor attributes and MVC/Razor Tag Helpers, immutable configurations, time fallbacks, fragment helpers, and typed content adapters. Preserves explicit false flags. See https://heimdall-framework.org/fluent-attributes.</PackageReleaseNotes>
		<RepositoryUrl>https://github.com/bradleyables22/Heimdall</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<PackageIcon>favicon.png</PackageIcon>

		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Favicon.png" Pack="true" PackagePath="favicon.png" />
		<None Include="..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
		<None Include="readme.md" Pack="true" PackagePath="\" />
		<None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
