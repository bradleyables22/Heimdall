<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<RunHeimdallJavaScriptBuild Condition="'$(RunHeimdallJavaScriptBuild)' == ''">true</RunHeimdallJavaScriptBuild>
		<HeimdallEsbuildMarker Condition="'$(OS)' == 'Windows_NT'">$(MSBuildProjectDirectory)\node_modules\.bin\esbuild.cmd</HeimdallEsbuildMarker>
		<HeimdallEsbuildMarker Condition="'$(HeimdallEsbuildMarker)' == ''">$(MSBuildProjectDirectory)/node_modules/.bin/esbuild</HeimdallEsbuildMarker>

		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageId>HeimdallFramework.Web</PackageId>
		<Version>3.0.0</Version>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<Authors>Bradley Ables</Authors>
		<Description>Heimdall JavaScript library.</Description>
		<PackageTags>heimdall framework;html;ssr;MVC;javascript;aspnetcore;rcl</PackageTags>

		<RepositoryUrl>https://github.com/bradleyables22/Heimdall</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<PackageIcon>heimdall-128.png</PackageIcon>

		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include="heimdall-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
		<None Include="readme.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="_build\**" />
		<Content Remove="build.mjs" />
		<Content Remove="node_modules\**" />
		<Content Remove="package-lock.json" />
		<Content Remove="package.json" />
		<Content Remove="tests\**" />

		<None Remove="_build\**" />
		<None Remove="build.mjs" />
		<None Remove="node_modules\**" />
		<None Remove="package-lock.json" />
		<None Remove="package.json" />
		<None Remove="tests\**" />
	</ItemGroup>

	<ItemGroup>
		<None Include="_build\**" Pack="false" Visible="true" />
		<None Include="tests\**" Pack="false" Visible="true" />
	</ItemGroup>

	<ItemGroup>
		<HeimdallJavaScriptInput Include="build.mjs" />
		<HeimdallJavaScriptInput Include="package.json" />
		<HeimdallJavaScriptInput Include="package-lock.json" />
		<HeimdallJavaScriptInput Include="_build\heimdall\**\*.js" />
	</ItemGroup>

	<Target Name="RestoreHeimdallJavaScriptTooling"
			BeforeTargets="BuildHeimdallJavaScript"
			Condition="'$(RunHeimdallJavaScriptBuild)' == 'true' and !Exists('$(HeimdallEsbuildMarker)')">
		<Message Text="Restoring Heimdall JavaScript tooling..." Importance="high" />
		<Exec Condition="'$(OS)' == 'Windows_NT'" WorkingDirectory="$(MSBuildProjectDirectory)" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;npm.cmd ci&quot;" />
		<Exec Condition="'$(OS)' != 'Windows_NT'" WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm ci" />
	</Target>

	<Target Name="BuildHeimdallJavaScript"
			BeforeTargets="PrepareForBuild;GenerateNuspec;ComputeFilesToPublish"
			Condition="'$(RunHeimdallJavaScriptBuild)' == 'true'"
			Inputs="@(HeimdallJavaScriptInput)"
			Outputs="$(IntermediateOutputPath)heimdall-js-build.stamp;$(MSBuildProjectDirectory)\wwwroot\heimdall-bundle.js;$(MSBuildProjectDirectory)\wwwroot\heimdall-bundle.min.js">
		<Message Text="Building Heimdall JavaScript bundle..." Importance="high" />
		<Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="node build.mjs" />
		<Touch Files="$(IntermediateOutputPath)heimdall-js-build.stamp" AlwaysCreate="true" />
	</Target>

</Project>